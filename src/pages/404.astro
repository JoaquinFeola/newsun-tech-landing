---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
---

<Layout title="Página no encontrada — NewSun Tech">
  <section class="bg-ink text-metal">
    <div class="mx-auto max-w-6xl px-5 py-32">
      <Logo class="mb-8 h-16 w-16 rounded-md" />
      <p class="label text-primary">Error 404</p>
      <h1 class="mt-4 font-display text-5xl font-extrabold md:text-6xl">Esta página no gira.</h1>
      <p class="mt-6 max-w-lg text-lg text-metal/75">La dirección que buscás no existe o se movió.</p>
      <a href="/" class="btn-primary mt-10">Volver al inicio</a>
    </div>
  </section>
</Layout>

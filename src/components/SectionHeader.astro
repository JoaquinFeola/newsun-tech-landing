---
interface Props {
  number: string;
  kicker: string;
  title: string;
  dark?: boolean;
}
const { number, kicker, title, dark = false } = Astro.props;
---

<div class="mb-10 max-w-3xl md:mb-12">
  <div class={`mb-4 flex items-center gap-3 ${dark ? "text-primary" : "text-primary-dark"}`}>
    <span class="label font-medium">{number}</span>
    <span class={`h-0.5 w-10 ${dark ? "bg-primary" : "bg-primary-dark"}`}></span>
    <span class="label">{kicker}</span>
  </div>
  <h2 class="font-display text-3xl font-bold leading-tight text-balance md:text-5xl">{title}</h2>
  {
    Astro.slots.has("default") && (
      <p class={`mt-5 text-base leading-relaxed md:text-lg ${dark ? "text-metal/80" : "text-ink-muted"}`}>
        <slot />
      </p>
    )
  }
</div>

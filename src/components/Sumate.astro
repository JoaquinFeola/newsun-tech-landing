---
/*
 * Formularios DEMOSTRATIVOS: no envían ni guardan datos.
 * Al enviar solo validan los campos y muestran el aviso de "recibido".
 */
const aparatos = ["Lavarropas", "Caminadora", "Bomba de agua", "Ventilador", "Herramienta eléctrica", "Otro"];
---

<section id="sumate" class="bg-ink text-metal">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 md:gap-14 py-16 md:py-24 lg:grid-cols-[1fr_1.3fr]">
    <div>
      <div class="mb-4 flex items-center gap-3 text-primary">
        <span class="label font-medium">07</span>
        <span class="h-0.5 w-10 bg-primary"></span>
        <span class="label">Sumate</span>
      </div>
      <h2 class="font-display text-3xl font-bold leading-tight text-balance md:text-5xl">¿Tenés un aparato viejo que vas a tirar?</h2>
      <p class="mt-5 text-base leading-relaxed text-metal/80 md:text-lg">
        Antes de dejarlo en la vereda, avisanos. Pasamos a buscarlo y le damos una segunda vida a su motor. Y si sos de
        una escuela técnica, sumate a la red de talleres que clasifican los motores.
      </p>
      <p class="label mt-8 border-l border-primary/60 pl-4 leading-relaxed text-metal/50">
        Formulario demostrativo:<br />los datos no se envían ni se guardan.
      </p>
    </div>

    <div class="overflow-hidden rounded-xl border border-metal/30 bg-paper text-ink shadow-2xl shadow-black/30">
      <div class="relative grid grid-cols-2 border-b border-line" role="tablist">
        <span class="tab-indicator" aria-hidden="true"></span>
        <button
          role="tab"
          data-tab-btn="donar"
          aria-selected="true"
          class="tab-btn label cursor-pointer border-r border-line px-3 py-3.5 text-left sm:px-4 sm:py-4">Donar un aparato</button
        >
        <button role="tab" data-tab-btn="escuela" aria-selected="false" class="tab-btn label cursor-pointer px-3 py-3.5 text-left sm:px-4 sm:py-4"
          >Soy escuela técnica</button
        >
      </div>

      <!-- Donación de aparato -->
      <form data-tab-panel="donar" data-mensaje="Coordinaremos con vos el retiro del aparato." class="grid gap-4 p-5 sm:grid-cols-2 sm:gap-5 sm:p-6 md:p-8">
        <label class="grid gap-1.5 sm:col-span-2">
          <span class="label">Nombre y apellido</span>
          <input name="nombre" required class="field" autocomplete="name" placeholder="Ej.: María González" />
        </label>
        <label class="grid gap-1.5">
          <span class="label">Teléfono o email</span>
          <input name="contacto" required class="field" placeholder="Ej.: 11 2345-6789 o maria@mail.com" />
        </label>
        <label class="grid gap-1.5">
          <span class="label">Localidad</span>
          <input name="localidad" required class="field" placeholder="Ej.: Luján" />
        </label>
        <label class="grid gap-1.5">
          <span class="label">Tipo de aparato</span>
          <span class="select-wrap">
            <select name="aparato" required class="field">
              <option value="" disabled selected hidden>Elegí una opción</option>
              {aparatos.map((a) => <option>{a}</option>)}
            </select>
          </span>
        </label>
        <label class="grid gap-1.5">
          <span class="label">¿Todavía enciende?</span>
          <span class="select-wrap">
            <select name="estado" class="field">
              <option value="" selected>Elegí una opción</option>
              <option>Sí, funciona</option>
              <option>Enciende pero falla</option>
              <option>No enciende</option>
              <option>No sé</option>
            </select>
          </span>
        </label>
        <label class="grid gap-1.5 sm:col-span-2">
          <span class="label">Comentarios (opcional)</span>
          <textarea name="comentarios" rows="3" class="field resize-y" placeholder="Marca, antigüedad, si tiene alguna falla conocida, horario para retirarlo…"></textarea>
        </label>
        <button type="submit" class="btn-primary cursor-pointer justify-center sm:col-span-2 sm:justify-self-start">Enviar aviso</button>
      </form>

      <!-- Solicitud de escuela técnica -->
      <form
        data-tab-panel="escuela"
        data-mensaje="Te contactaremos para coordinar la primera entrega de aparatos a tu escuela."
        class="grid gap-4 p-5 sm:grid-cols-2 sm:gap-5 sm:p-6 md:p-8"
        hidden
      >
        <label class="grid gap-1.5 sm:col-span-2">
          <span class="label">Nombre de la escuela</span>
          <input name="escuela" required class="field" placeholder="Ej.: E.E.S.T. N.º 1 &quot;Mariano Moreno&quot;" />
        </label>
        <label class="grid gap-1.5">
          <span class="label">Persona de contacto</span>
          <input name="responsable" required class="field" autocomplete="name" placeholder="Ej.: Prof. Juan Pérez" />
        </label>
        <label class="grid gap-1.5">
          <span class="label">Email</span>
          <input name="email" type="email" required class="field" autocomplete="email" placeholder="taller@escuela.edu.ar" />
        </label>
        <label class="grid gap-1.5">
          <span class="label">Localidad</span>
          <input name="localidad" required class="field" placeholder="Ej.: Luján" />
        </label>
        <label class="grid gap-1.5">
          <span class="label">Cantidad aproximada</span>
          <input name="cantidad" type="number" min="1" class="field" placeholder="Ej.: 5" />
        </label>
        <label class="grid gap-1.5 sm:col-span-2">
          <span class="label">¿Con qué cursos o talleres trabajarían?</span>
          <textarea name="uso" rows="3" required class="field resize-y" placeholder="Ej.: 4.º y 5.º año de electromecánica, en el taller de máquinas eléctricas…"></textarea>
        </label>
        <button type="submit" class="btn-primary justify-center sm:col-span-2 sm:justify-self-start">Enviar solicitud</button>
      </form>
    </div>
  </div>
</section>

<dialog id="recibido" class="m-auto w-[min(28rem,calc(100%-2rem))] overflow-hidden rounded-xl border border-ink bg-paper p-0 text-ink backdrop:bg-ink/70">
  <div class="flex items-center gap-3 border-b border-line bg-primary px-6 py-3">
    <span class="grid h-6 w-6 place-items-center rounded-full border border-ink bg-paper font-mono text-sm">✓</span>
    <span class="label font-medium">Recibido</span>
  </div>
  <div class="p-6">
    <p class="font-display text-2xl font-bold">¡Gracias!</p>
    <p id="recibido-msg" class="mt-2 leading-relaxed text-ink-muted"></p>
    <form method="dialog" class="mt-6">
      <button class="btn-primary">Cerrar</button>
    </form>
  </div>
</dialog>

<style>
  /* Fondo que se desliza bajo la pestaña activa */
  .tab-indicator {
    position: absolute;
    inset: 0 auto 0 0;
    width: 50%;
    background: var(--color-ink);
    transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
  }
  [role="tablist"]:has([data-tab-btn="escuela"][aria-selected="true"]) .tab-indicator {
    transform: translateX(100%);
  }
  .tab-btn {
    position: relative;
    transition:
      color 0.3s ease,
      background-color 0.2s ease,
      transform 0.1s ease;
  }
  .tab-btn[aria-selected="true"] {
    color: var(--color-primary);
  }
  .tab-btn[aria-selected="false"]:hover {
    background: var(--color-paper-deep);
  }
  .tab-btn:active {
    transform: scale(0.98);
  }

  /* Al cambiar de pestaña: el formulario entra desde el lado elegido
     y sus campos aparecen escalonados */
  .panel-in {
    animation: panel-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .panel-in > * {
    animation: field-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i, 0) * 45ms + 80ms);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateX(calc(var(--dir, 1) * 24px));
    }
  }
  @keyframes field-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab-indicator,
    .tab-btn {
      transition: none;
    }
    .panel-in,
    .panel-in > * {
      animation: none;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-tab-btn]");
  const panels = document.querySelectorAll<HTMLFormElement>("[data-tab-panel]");
  const dialog = document.getElementById("recibido") as HTMLDialogElement;
  const msg = document.getElementById("recibido-msg")!;

  const order = Array.from(buttons, (b) => b.dataset.tabBtn!);

  // Índice de cada campo para escalonar su animación de entrada
  panels.forEach((p) => Array.from(p.children).forEach((c, i) => (c as HTMLElement).style.setProperty("--i", String(i))));

  function showTab(name: string) {
    const current = Array.from(panels).find((p) => !p.hidden)?.dataset.tabPanel;
    if (current === name) return;
    const dir = order.indexOf(name) > order.indexOf(current ?? "") ? 1 : -1;

    buttons.forEach((b) => b.setAttribute("aria-selected", String(b.dataset.tabBtn === name)));
    panels.forEach((p) => {
      p.hidden = p.dataset.tabPanel !== name;
      p.classList.remove("panel-in");
      if (!p.hidden) {
        p.style.setProperty("--dir", String(dir));
        void p.offsetWidth; // fuerza un reflow para reiniciar la animación
        p.classList.add("panel-in");
      }
    });
  }

  buttons.forEach((b) => b.addEventListener("click", () => showTab(b.dataset.tabBtn!)));

  // Enlaces externos que abren una pestaña concreta (p. ej. "Soy de una escuela técnica")
  document.querySelectorAll<HTMLAnchorElement>("a[data-tab]").forEach((a) =>
    a.addEventListener("click", () => showTab(a.dataset.tab!)),
  );

  panels.forEach((form) =>
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      msg.textContent = form.dataset.mensaje ?? "";
      form.reset();
      dialog.showModal();
    }),
  );
</script>

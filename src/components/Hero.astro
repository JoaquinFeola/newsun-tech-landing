---
import HeroBackground, { type Fondo } from "./HeroBackground.astro";

interface Props {
  fondo?: Fondo;
}
const { fondo = "aspas" } = Astro.props;

// En desarrollo se renderizan todas las variantes para poder compararlas con ?fondo=aspas|viento|cuadricula
const variantes: Fondo[] = import.meta.env.DEV ? ["aspas", "viento", "cuadricula"] : [fondo];

const ficha = [
  { k: "Origen", v: "Punto limpio y donaciones" },
  { k: "Clasifican", v: "Escuelas técnicas de la región" },
  { k: "Destino A", v: "Generador eólico para el campo" },
  { k: "Destino B", v: "Práctica en el taller escolar" },
  { k: "Descarte", v: "Ninguno" },
];
---

<section id="inicio" class="relative overflow-hidden bg-ink text-metal">
  {
    variantes.map((v) => (
      <div data-fondo={v} hidden={v !== fondo}>
        <HeroBackground variante={v} />
      </div>
    ))
  }
  <div class="relative mx-auto grid max-w-6xl gap-12 px-5 py-14 md:gap-14 md:py-28 lg:grid-cols-[1.4fr_1fr] lg:items-end">
    <div>
      <p class="label mb-6 text-primary">Recuperación de motores eléctricos</p>
      <h1 class="font-display text-5xl font-extrabold leading-[1.02] tracking-tight md:text-7xl">
        Motores que<br />vuelven a <span class="text-primary">girar</span>.
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-metal/80 md:mt-8 md:text-lg">
        Lavarropas, caminadoras, bombas y ventiladores tienen motores que todavía funcionan. Nosotros los rescatamos de la
        chatarra y las escuelas técnicas de la región los clasifican: los que sirven vuelven a nosotros y los convertimos
        en generadores eólicos para productores rurales, y los que no, se quedan en el taller para que los estudiantes aprendan con
        ellos.
      </p>
      <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap sm:gap-4 md:mt-10">
        <a href="#generador" class="btn-primary justify-center">Ver el generador →</a>
        <a href="#sumate" class="btn-ghost justify-center">Tengo un aparato viejo</a>
      </div>
    </div>

    <aside class="overflow-hidden rounded-lg border border-metal/40 bg-ink-soft">
      <div class="flex items-center justify-between border-b border-metal/40 px-5 py-3">
        <span class="label text-primary">Ficha del proyecto</span>
        <span class="label text-metal/50">N.º 001</span>
      </div>
      <dl>
        {
          ficha.map((f) => (
            <div class="grid grid-cols-[6.5rem_1fr] border-b border-metal/15 px-4 py-3 last:border-0 sm:grid-cols-[7rem_1fr] sm:px-5 sm:py-4">
              <dt class="label pt-0.5 text-metal/50">{f.k}</dt>
              <dd class="font-medium">{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
  <div class="h-1 bg-primary"></div>
</section>

{
  import.meta.env.DEV && (
    <script is:inline>
      (() => {
        const pedido = new URLSearchParams(location.search).get("fondo");
        if (!pedido) return;
        document.querySelectorAll("[data-fondo]").forEach((el) => (el.hidden = el.dataset.fondo !== pedido));
      })();
    </script>
  )
}

---
/*
 * Logo provisorio (engranaje + rayo) dibujado con los tokens de marca.
 * Cuando tengan el archivo definitivo, guárdenlo en src/assets/logo.svg
 * y reemplacen el <svg> por: <img src={logo.src} alt="NewSun Tech" class={cls} />
 */
interface Props {
  class?: string;
}
const { class: cls = "h-10 w-10" } = Astro.props;

const teeth = Array.from({ length: 8 }, (_, i) => i * 45);
---

<svg viewBox="0 0 64 64" class={cls} role="img" aria-label="NewSun Tech">
  <rect width="64" height="64" fill="var(--brand-graphite)" />
  <g fill="var(--brand-steel)">
    {teeth.map((deg) => <rect x="28" y="6" width="8" height="10" transform={`rotate(${deg} 32 32)`} />)}
    <circle cx="32" cy="32" r="19" />
  </g>
  <circle cx="32" cy="32" r="13" fill="var(--brand-graphite)" />
  <path d="M35 18 L24 35 H31 L28 46 L40 28 H33 Z" fill="var(--brand-amber)" />
</svg>
